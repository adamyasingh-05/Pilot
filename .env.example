# Pilot loads provider credentials from your LOCAL OS keychain by default
# (see `pilot config keys`). This file is only a fallback for environments
# where OS keychain access is unavailable (e.g. some CI/headless setups).
#
# Never commit a real .env file. It is git-ignored by default.

# One of: ollama | openai | anthropic | openrouter | gemini
PILOT_PROVIDER=ollama

# Only needed if PILOT_PROVIDER=ollama and it's not on the default host
OLLAMA_HOST=http://127.0.0.1:11434

# The keys below are read ONLY if the OS keychain has no stored key for
# the selected provider. Prefer `pilot config keys set <provider>` instead
# of putting keys in plaintext here.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
